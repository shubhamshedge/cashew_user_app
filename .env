# ==============================================================================
# CASHEW STORE (USER MOBILE & WEB APP) ENVIRONMENT CONFIGURATION
# ==============================================================================
# Environment: development | staging | production
APP_ENV="development"
APP_NAME="Cashew Store"

# ==============================================================================
# API ENDPOINT SECURITY & ROUTING
# ==============================================================================
# Android Emulator loopback: http://10.0.2.2:3000/api/v1
# Physical Device / Local LAN: http://<your-lan-ip>:3000/api/v1
# Web / iOS Simulator: http://localhost:3000/api/v1
# Production: https://api.yourdomain.com/api/v1
API_BASE_URL="http://10.0.2.2:3000/api/v1"
API_TIMEOUT_SECONDS=15

# ==============================================================================
# CLIENT-SAFE PAYMENT GATEWAY KEYS (PUBLIC / PUBLISHABLE ONLY)
# ==============================================================================
# Never place Razorpay Key Secret or Stripe Secret Key here!
RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
STRIPE_PUBLISHABLE_KEY="pk_test_yourStripePublishableKey"

# ==============================================================================
# FIREBASE & NOTIFICATIONS CONFIGURATION
# ==============================================================================
FIREBASE_PROJECT_ID="cashew-app-16075"
FIREBASE_APP_ID="1:300774425429:android:78a0ff47d527b17748a5dc"
FIREBASE_API_KEY="AIzaSyANsNmR-bjKAmpt2dF2mspakMeMNZ4w97o"
FIREBASE_STORAGE_BUCKET="cashew-app-16075.firebasestorage.app"
DEFAULT_NOTIFICATION_CHANNEL_ID="cashew_store_orders"

# ==============================================================================
# SECURITY & FEATURE FLAGS
# ==============================================================================
ENABLE_CRASHLYTICS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_DEBUG_LOGS=true
SECURE_STORAGE_KEY_PREFIX="cashew_store_secure_"
